/**
 * CSS Playground — Google Sheets submission receiver
 *
 * Sheet columns:
 *   A: Nama
 *   B: Tugas
 *   C: Waktu Pengumpulan
 *   D: Kode CSS / Jawaban Siswa
 *   E: Status Jawaban
 *   F: Kriteria Lolos
 *   G: Total Kriteria
 *   H: Nilai (%)
 *   I: Rincian Penilaian
 */

const CONFIG = {
  SPREADSHEET_NAME: 'CSS Playground - Pengumpulan Tugas',
  SHEET_NAME: 'Pengumpulan',
  TIME_ZONE: 'Asia/Jakarta',
  RECEIPT_TTL_SECONDS: 600,
  MAX_CSS_LENGTH: 45000,
  MAX_DETAILS_LENGTH: 15000
};

const HEADERS = [
  'Nama',
  'Tugas',
  'Waktu Pengumpulan',
  'Kode CSS / Jawaban Siswa',
  'Status Jawaban',
  'Kriteria Lolos',
  'Total Kriteria',
  'Nilai (%)',
  'Rincian Penilaian'
];

/**
 * Run once from the Apps Script editor.
 * Creates the spreadsheet and submission tab, or upgrades its headers.
 * Existing rows in columns A-C are preserved.
 */
function setup() {
  const properties = PropertiesService.getScriptProperties();
  let spreadsheetId = properties.getProperty('SPREADSHEET_ID');
  let spreadsheet;

  if (spreadsheetId) {
    spreadsheet = SpreadsheetApp.openById(spreadsheetId);
  } else {
    spreadsheet = SpreadsheetApp.create(CONFIG.SPREADSHEET_NAME);
    spreadsheetId = spreadsheet.getId();
    properties.setProperty('SPREADSHEET_ID', spreadsheetId);
  }

  spreadsheet.setSpreadsheetTimeZone(CONFIG.TIME_ZONE);

  let sheet = spreadsheet.getSheetByName(CONFIG.SHEET_NAME);
  if (!sheet) {
    sheet = spreadsheet.insertSheet(CONFIG.SHEET_NAME);
  }

  // Keep the original first three columns in place for backwards compatibility.
  sheet.getRange(1, 1, 1, HEADERS.length).setValues([HEADERS]);
  sheet.setFrozenRows(1);
  sheet.getRange(1, 1, 1, HEADERS.length)
    .setFontWeight('bold')
    .setBackground('#e8eefc')
    .setFontColor('#1e293b')
    .setWrap(true);

  sheet.setColumnWidth(1, 210);
  sheet.setColumnWidth(2, 340);
  sheet.setColumnWidth(3, 185);
  sheet.setColumnWidth(4, 420);
  sheet.setColumnWidth(5, 180);
  sheet.setColumnWidth(6, 115);
  sheet.setColumnWidth(7, 115);
  sheet.setColumnWidth(8, 100);
  sheet.setColumnWidth(9, 440);

  sheet.getRange('C:C').setNumberFormat('dd/MM/yyyy HH:mm:ss');
  sheet.getRange('D:D').setNumberFormat('@');
  sheet.getRange('I:I').setNumberFormat('@');

  Logger.log('Spreadsheet siap: ' + spreadsheet.getUrl());
  return spreadsheet.getUrl();
}

/**
 * Receive one submission from the CSS Playground.
 * The timestamp is generated by Apps Script, never trusted from the browser.
 */
function doPost(e) {
  const lock = LockService.getScriptLock();

  try {
    if (!e || !e.postData || !e.postData.contents) {
      return jsonResponse_({ ok: false, error: 'Empty request body.' });
    }

    const payload = JSON.parse(e.postData.contents);
    const submissionId = cleanText_(payload.submissionId, 80);
    const studentName = cleanText_(payload.name, 100);
    const taskName = cleanText_(payload.task, 180);
    const cssCode = String(payload.cssCode == null ? '' : payload.cssCode);
    const scoreInput = payload.score || {};
    const passed = Number(scoreInput.passed);
    const total = Number(scoreInput.total);
    const rawCriteria = Array.isArray(payload.criteria) ? payload.criteria : [];

    if (!/^[a-zA-Z0-9_-]{12,80}$/.test(submissionId)) {
      return jsonResponse_({ ok: false, error: 'Invalid submission ID.' });
    }
    if (!studentName) {
      return jsonResponse_({ ok: false, error: 'Student name is required.' });
    }
    if (!taskName) {
      return jsonResponse_({ ok: false, error: 'Task name is required.' });
    }
    if (cssCode.length > CONFIG.MAX_CSS_LENGTH) {
      return jsonResponse_({ ok: false, error: 'CSS code is too long for one Google Sheets cell.' });
    }
    if (!Number.isInteger(passed) || !Number.isInteger(total) ||
        total < 1 || total > 100 || passed < 0 || passed > total) {
      return jsonResponse_({ ok: false, error: 'Invalid score.' });
    }
    if (rawCriteria.length !== total) {
      return jsonResponse_({ ok: false, error: 'The number of assessment criteria does not match the score.' });
    }

    if (rawCriteria.some(item => !item || typeof item.passed !== 'boolean')) {
      return jsonResponse_({ ok: false, error: 'Invalid criterion result.' });
    }

    const criteria = rawCriteria.map((item, index) => ({
      criterion: cleanText_(item.label, 180) || ('Kriteria ' + (index + 1)),
      passed: item.passed,
      feedback: cleanText_(item.feedback, 500)
    }));

    const actualPassed = criteria.filter(item => item.passed).length;
    if (actualPassed !== passed) {
      return jsonResponse_({ ok: false, error: 'Score does not match the criterion results.' });
    }

    const scorePercent = Math.round((passed / total) * 100);
    const answerStatus = passed === total ? 'LULUS' : 'PERLU PERBAIKAN';
    const detailsJson = JSON.stringify(criteria);

    if (detailsJson.length > CONFIG.MAX_DETAILS_LENGTH) {
      return jsonResponse_({ ok: false, error: 'Assessment details are too long.' });
    }

    lock.waitLock(15000);

    const cache = CacheService.getScriptCache();
    const receiptKey = 'submission_' + submissionId;

    // Idempotency: retrying with the same ID will never append a second row.
    if (cache.get(receiptKey) === 'saved') {
      return jsonResponse_({ ok: true, duplicate: true });
    }

    const spreadsheetId = PropertiesService.getScriptProperties()
      .getProperty('SPREADSHEET_ID');

    if (!spreadsheetId) {
      throw new Error('Spreadsheet is not configured. Run setup() first.');
    }

    const spreadsheet = SpreadsheetApp.openById(spreadsheetId);
    let sheet = spreadsheet.getSheetByName(CONFIG.SHEET_NAME);

    if (!sheet) {
      sheet = spreadsheet.insertSheet(CONFIG.SHEET_NAME);
      sheet.getRange(1, 1, 1, HEADERS.length).setValues([HEADERS]);
      sheet.setFrozenRows(1);
      sheet.getRange('C:C').setNumberFormat('dd/MM/yyyy HH:mm:ss');
      sheet.getRange('D:D').setNumberFormat('@');
      sheet.getRange('I:I').setNumberFormat('@');
    }

    const submittedAt = new Date();
    const row = [
      safeSheetText_(studentName),
      safeSheetText_(taskName),
      submittedAt,
      safeSheetText_(cssCode),
      answerStatus,
      passed,
      total,
      scorePercent,
      safeSheetText_(detailsJson)
    ];

    sheet.appendRow(row);

    // Receipt is only for browser confirmation; it is not stored in the sheet.
    cache.put(receiptKey, 'saved', CONFIG.RECEIPT_TTL_SECONDS);

    return jsonResponse_({ ok: true });
  } catch (error) {
    console.error(error);
    return jsonResponse_({
      ok: false,
      error: String(error && error.message ? error.message : error)
    });
  } finally {
    if (lock.hasLock()) {
      lock.releaseLock();
    }
  }
}

/**
 * JSONP receipt check. Callback names are strictly allow-listed.
 */
function doGet(e) {
  const params = (e && e.parameter) || {};

  if (params.action !== 'status') {
    return ContentService
      .createTextOutput('CSS Playground submission endpoint is active.')
      .setMimeType(ContentService.MimeType.TEXT);
  }

  const callback = String(params.callback || '');
  const submissionId = String(params.id || '');

  if (!/^__cssQuestAck_[A-Za-z0-9_]+$/.test(callback) ||
      !/^[a-zA-Z0-9_-]{12,80}$/.test(submissionId)) {
    return ContentService
      .createTextOutput('/* Invalid status request */')
      .setMimeType(ContentService.MimeType.JAVASCRIPT);
  }

  const saved = CacheService.getScriptCache()
    .get('submission_' + submissionId) === 'saved';

  return ContentService
    .createTextOutput(callback + '(' + JSON.stringify({ ok: saved }) + ');')
    .setMimeType(ContentService.MimeType.JAVASCRIPT);
}

function cleanText_(value, maxLength) {
  return String(value == null ? '' : value)
    .replace(/[\u0000-\u001F\u007F]/g, ' ')
    .replace(/\s+/g, ' ')
    .trim()
    .slice(0, maxLength);
}

/**
 * Prevent a user-supplied cell value from being interpreted as a formula.
 * The leading apostrophe is the spreadsheet's text-literal marker.
 */
function safeSheetText_(value) {
  const text = String(value == null ? '' : value);
  return /^[=+\-]/.test(text) ? "'" + text : text;
}

function jsonResponse_(data) {
  return ContentService
    .createTextOutput(JSON.stringify(data))
    .setMimeType(ContentService.MimeType.JSON);
}
